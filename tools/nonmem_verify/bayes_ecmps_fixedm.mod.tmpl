$PROBLEM EC-MPS, de Winter 2008, morning-lag subgroup MX FIXED per run (no $MIX): individual posterior, population frozen (BIONLY)
$INPUT ID TIME AMT EVID MDV SS II CLK DV MX
$DATA post_ecmps_mMM.csv IGNORE=@
$SUBROUTINES ADVAN4 TRANS4
$PK
 CL    = 16*EXP(ETA(1))
 Q     = 22*EXP(ETA(2))
 V2    = 40*EXP(ETA(3))
 V3    = 518*EXP(ETA(4))
 KA    = 3.0*EXP(ETA(5))
 IF (MX.EQ.1) TLM = 0.95
 IF (MX.EQ.2) TLM = 1.88
 IF (MX.EQ.3) TLM = 4.83
 IF (CLK.GE.6 .AND. CLK.LT.18) THEN
   ALAG1 = TLM*EXP(ETA(6))    ; morning dose: mixture lag
 ELSE
   ALAG1 = 9.04*EXP(ETA(7))   ; evening dose
 ENDIF
 S2    = V2
$ERROR
 IPRED = F
 IF (IPRED.LT.1E-12) IPRED = 1E-12
 Y = LOG(IPRED) + EPS(1)
$THETA (0 FIX)
$OMEGA 0.1521                ; CL
$OMEGA 0.6084                ; Q
$OMEGA 1.0                ; V1
$OMEGA 24.01                ; V2
$OMEGA 3.4969                ; ka
$OMEGA 0.0064                ; tlag morning  8 %
$OMEGA 0.16                ; tlag evening 40 %
$SIGMA 0.1521    
$ESTIMATION METHOD=BAYES BIONLY=1 BAYES_PHI_STORE=1 NBURN=1500 NITER=5000 PRINT=1000 SEED=SEEDMM NOABORT
