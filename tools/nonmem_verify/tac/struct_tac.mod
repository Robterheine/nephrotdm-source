$PROBLEM Structural check, tacrolimus: Storset 2014 model, etas supplied as data (no estimation)
$INPUT ID TIME AMT EVID MDV SS II FFM EXPR PDN HCT E1 E2 E3 E4 E5 DV
$DATA struct_tac.csv IGNORE=@
$SUBROUTINES ADVAN4 TRANS4
$PK
 W = FFM/60
 CL = 811*(W**0.75)*(1+0.30*EXPR)*EXP(E1)
 V2 = 6290*W*EXP(E2+ETA(1))
 Q  = 1200*(W**0.75)*EXP(E3)
 V3 = 32100*W
 KA = 1.01*EXP(E5)
 ALAG1 = 0.41
 F1 = (1-0.67*PDN/(35+PDN))*(1-0.18*EXPR)*EXP(E4)
 S2 = V2
$ERROR
 CP = F
 IPRED = CP*(1+HCT*418/(CP+3.8))
 Y = IPRED + EPS(1)
$THETA (0 FIX)
$OMEGA 0 FIX
$SIGMA 0.1 FIX
$ESTIMATION METHOD=0 MAXEVAL=0 NOABORT
$TABLE ID TIME IPRED NOPRINT ONEHEADER NOAPPEND FORMAT=s1PE15.8 FILE=struct_tac.tab
